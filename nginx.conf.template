server {
    listen 8080;
    listen [::]:8080;

    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Healthcheck - nie powinien przechodzić przez SPA fallback
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API -> backend.  /api/xyz  ->  ${BACKEND_URL}/api/v1/xyz
    # (to samo mapowanie co proxy w vite.config.ts)
    #
    # Statyczny proxy_pass (bez resolvera): nazwę "backend" dostarcza ECS Service Connect
    # przez /etc/hosts, a nie DNS. Wskazuje ona na lokalny proxy Service Connect,
    # który sam śledzi zmiany IP tasków backendu, więc restart nginx nie jest potrzebny.
    # BACKEND_URL musi być bez ścieżki (np. http://backend:8000), żeby przeszedł URI z rewrite.
    location /api/ {
        rewrite ^/api/(.*)$ /api/v1/$1 break;
        proxy_pass ${BACKEND_URL};

        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        client_max_body_size  20m;
    }

    # Konfiguracja runtime (generowana przy starcie kontenera) nigdy z cache,
    # inaczej po zmianie parametru w SSM przeglądarki trzymałyby starą wersję 7 dni
    location = /env.js {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # index.html nigdy z cache
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Assety Vite z hashami
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Pozostałe statyczne pliki
    location ~* \.(?:ico|css|js|mjs|json|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|map)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # React SPA / React Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}