server {
    listen 8080;
    listen [::]:8080;

    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # DNS VPC (Amazon) - backend jest rozwiązywany dynamicznie,
    # więc nowe IP tasków backendu są łapane bez restartu nginx
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # Healthcheck - nie powinien przechodzić przez SPA fallback
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API -> backend.  /api/xyz  ->  ${BACKEND_URL}/api/v1/xyz
    # (to samo mapowanie co proxy w vite.config.ts)
    location /api/ {
        set $backend "${BACKEND_URL}";
        rewrite ^/api/(.*)$ /api/v1/$1 break;
        proxy_pass $backend;

        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        client_max_body_size  20m;
    }

    # index.html nigdy z cache
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Assety Vite z hashami
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Pozostałe statyczne pliki
    location ~* \.(?:ico|css|js|mjs|json|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|map)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # React SPA / React Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}